# Copy to infra/compose/.env for local overrides. Values below are development-only.
COMPOSE_PROFILES=dev
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_DB=vidcar
POSTGRES_USER=vidcar
POSTGRES_PASSWORD=local-dev-postgres-change-me
DATABASE_URL=postgresql://vidcar:local-dev-postgres-change-me@postgres:5432/vidcar

RABBITMQ_USER=vidcar
RABBITMQ_PASSWORD=local-dev-rabbitmq-change-me
RABBITMQ_VHOST=vidcar
RABBITMQ_URL=amqp://vidcar:local-dev-rabbitmq-change-me@rabbitmq:5672/vidcar

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-change-me
KEYCLOAK_URL=http://keycloak:8080/auth

# Local fallback. For the central 60 TB S3 service, replace endpoint/credentials
# with operator-provided values; Compose never formats or mounts that storage.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=vidcar-local-dev
S3_SECRET_KEY=local-dev-minio-change-me
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local fallback is intentionally under the repository. On a prepared node use:
# SCRATCH_ROOT=/srv/vehicle-ai/scratch
# Compose creates/mounts the directory only; it never formats a device.
SCRATCH_ROOT=../../.runtime/scratch
GPU_COUNT=1
GPU_WORKER_ID=gpu-main
NVIDIA_VISIBLE_DEVICES=all

PROMETHEUS_RETENTION=15d
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-grafana-change-me
