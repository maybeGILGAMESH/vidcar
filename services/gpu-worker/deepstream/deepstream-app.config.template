# DeepStream 9.1 template. Replace ${...} only with validated deployment values.
[application]
enable-perf-measurement=1
perf-measurement-interval-sec=5

[source0]
enable=1
type=3
uri=file://${INPUT_VIDEO}
num-sources=1
gpu-id=${GPU_ID}

[streammux]
gpu-id=${GPU_ID}
batch-size=1
width=${MUX_WIDTH}
height=${MUX_HEIGHT}
batched-push-timeout=40000
live-source=0

[primary-gie]
enable=1
gpu-id=${GPU_ID}
batch-size=1
config-file=${VALIDATED_APPROVED_NVINFER_CONFIG}

[tracker]
enable=1
tracker-width=960
tracker-height=544
gpu-id=${GPU_ID}
ll-lib-file=${NVDCF_TRACKER_LIBRARY}
ll-config-file=${NVDCF_TRACKER_CONFIG}

[sink0]
enable=1
type=1
sync=0
qos=0

# OCR is intentionally absent until a locally approved Cyrillic model has
# source, license, version and SHA-256 metadata. Baseline output must retain:
# production_russian_ocr=false and ocr_mode=baseline|latin|local_allowlist.
