{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidcar.local/schemas/model-manifest-1.json",
  "title": "Approved model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "models"],
  "properties": {
    "schema_version": {"const": "model-manifest-1"},
    "pipeline_version": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(?i)latest"}
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "path", "sha256", "source", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1, "not": {"pattern": "(?i)latest"}},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "format": {"enum": ["paddle", "onnx", "tensorrt", "other"]},
          "task": {"type": "string"}
        }
      }
    },
    "ocr_capability": {
      "type": "object",
      "required": ["mode", "production_russian_ocr"],
      "properties": {
        "mode": {"enum": ["baseline", "latin", "local_allowlist", "cyrillic_approved"]},
        "production_russian_ocr": {"type": "boolean"}
      }
    }
  }
}
