# Empty = same-origin via nginx at http://localhost:8080/api/...
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_OIDC_AUTHORITY=https://identity.example.com
NEXT_PUBLIC_OIDC_CLIENT_ID=vidcar-web
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:8080/
NEXT_PUBLIC_OIDC_SCOPE=openid profile offline_access
